# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# --- Supabase ---
# Found in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - server-side only, bypasses Row Level Security.
# NEVER prefix this with NEXT_PUBLIC_. NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Provider ---
# Which AI provider implementation to use. Currently only "anthropic" exists.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Voice (optional) ---
# Only needed for Urdu voice playback in the teaching chat. Leave blank if
# you don't need Urdu text-to-speech — everything else works without it.
# Free account, no card needed: https://elevenlabs.io
ELEVENLABS_API_KEY=

# --- App ---
# Base URL of the deployed app (used for auth redirect links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
